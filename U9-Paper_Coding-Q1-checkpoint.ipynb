   "source": [
    "#Write a program that prints multiplication of 2\n",
    "#Use while statement\n",
    "\n",
    "i = 2\n",
    "j = 1\n",
    "\n",
    "while j <= 9:\n",
    "    print(f\"{i} * {j} = {i * j}\")\n",
    "    j += 1"
   ]
