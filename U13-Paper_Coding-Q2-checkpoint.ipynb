   "source": [
    "#Create a 2D list of 4 x 4 size with values ranging from 1 to 16\n",
    "#Print the elements using the for loop\n",
    "\n",
    "matrix = [\n",
    "    list(range(1,5)),\n",
    "    list(range(5,9)),\n",
    "    list(range(9,13)),\n",
    "    list(range(13,17))\n",
    "]\n",
    "for i in matrix:\n",
    "    for j in i:\n",
    "        print(j,end=\" \")\n",
    "    print()"
   ]
  }
